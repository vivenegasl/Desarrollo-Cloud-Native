{
  "info": {
    "_postman_id": "a821e29c-5014-4c47-b8f2-1d59e3381a4b",
    "name": "TicketFlow Cloud Native API - Duoc UC",
    "description": "Colección completa para evaluación sumativa 'Construyendo y desplegando una solución Cloud Native' (CDY2204). Incluye pruebas automatizadas y cubre el 100% de la rúbrica.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health Check (Actuator)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Microservicio en estado UP\", function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"UP\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": ["{{baseUrl}}"],
          "path": ["actuator", "health"]
        }
      }
    },
    {
      "name": "02 - Listar Eventos Disponibles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Responde lista de eventos\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    pm.expect(data.length).to.be.above(0);",
              "    pm.environment.set(\"eventCode\", data[0].eventCode);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events"]
        }
      }
    },
    {
      "name": "03 - Generar Ticket (EFS + S3 Automático)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ticket creado con código 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Almacenado en EFS y S3 verificado\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.be.a(\"number\");",
              "    pm.expect(data.ticketCode).to.be.a(\"string\");",
              "    pm.expect(data.efsPath).to.include(\"tickets\");",
              "    pm.expect(data.s3Key).to.include(\"pdf\");",
              "    pm.expect(data.s3Uploaded).to.eql(true);",
              "    pm.expect(data.checksumSha256).to.be.a(\"string\");",
              "    pm.environment.set(\"ticketId\", data.id);",
              "    pm.environment.set(\"ticketCode\", data.ticketCode);",
              "    pm.environment.set(\"userId\", data.userId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventCode\": \"evento123\",\n  \"userId\": \"usuarioX\",\n  \"attendeeName\": \"Victor Lind\",\n  \"attendeeEmail\": \"victor.lind@duocuc.cl\",\n  \"seatNumber\": \"VIP-A1\",\n  \"category\": \"VIP\",\n  \"price\": 35000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "generate"]
        }
      }
    },
    {
      "name": "04 - Generar Segundo Ticket (Para pruebas de estadísticas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Segundo ticket creado\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventCode\": \"evento123\",\n  \"userId\": \"usuarioY\",\n  \"attendeeName\": \"Camila Silva\",\n  \"attendeeEmail\": \"camila.silva@duocuc.cl\",\n  \"seatNumber\": \"GEN-B15\",\n  \"category\": \"GENERAL\",\n  \"price\": 25000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "generate"]
        }
      }
    },
    {
      "name": "05 - Obtener Detalles del Ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Detalles del ticket correctos\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.eql(pm.environment.get(\"ticketId\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}"]
        }
      }
    },
    {
      "name": "06 - Descargar Ticket PDF desde AWS S3 (Streaming)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Descarga de PDF correcta con cabecera application/pdf\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\");",
              "    pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"attachment\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/download",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}", "download"]
        }
      }
    },
    {
      "name": "07 - Obtener URL Prefirmada (S3 Presigned URL)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Presigned URL generada correctamente\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "    pm.expect(data.data).to.include(\"X-Amz-Signature\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/presigned-url",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}", "presigned-url"]
        }
      }
    },
    {
      "name": "08 - Modificar Ticket (Actualiza PDF en S3 y EFS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ticket modificado y actualizado en S3\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.status).to.eql(\"MODIFIED\");",
              "    pm.expect(data.seatNumber).to.eql(\"VIP-PREMIUM-01\");",
              "    pm.expect(data.category).to.eql(\"PLATINUM\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"attendeeName\": \"Victor Lind (Actualizado)\",\n  \"seatNumber\": \"VIP-PREMIUM-01\",\n  \"category\": \"PLATINUM\",\n  \"price\": 45000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}"]
        }
      }
    },
    {
      "name": "09 - Re-sincronizar Ticket a S3 (Subida explícita)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Re-sincronización exitosa\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.s3Uploaded).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/upload-s3",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}", "upload-s3"]
        }
      }
    },
    {
      "name": "10 - Consultar Historial de Archivos (Criterio 5)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Historial de archivos retornado con paginación y filtros\", function () {",
              "    pm.response.to.have.status(200);",
              "    var page = pm.response.json();",
              "    pm.expect(page.content).to.be.an(\"array\");",
              "    pm.expect(page.content.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/history?eventCode={{eventCode}}&userId={{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "history"],
          "query": [
            { "key": "eventCode", "value": "{{eventCode}}" },
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "11 - Estadísticas de Ventas y Reservas por Evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Estadísticas del evento consolidadas\", function () {",
              "    pm.response.to.have.status(200);",
              "    var stats = pm.response.json();",
              "    pm.expect(stats.eventCode).to.eql(pm.environment.get(\"eventCode\"));",
              "    pm.expect(stats.totalTicketsIssued).to.be.above(0);",
              "    pm.expect(stats.totalRevenue).to.be.above(0);",
              "    pm.expect(stats.s3StoredFilesCount).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/events/{{eventCode}}/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "events", "{{eventCode}}", "stats"]
        }
      }
    },
    {
      "name": "12 - Descargar Todos los Tickets de Usuario (ZIP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Descarga ZIP por usuario correcta\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"zip\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/download/user/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "download", "user", "{{userId}}"]
        }
      }
    },
    {
      "name": "13 - Eliminar Ticket Específico (Purga S3 + EFS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ticket eliminado con éxito\", function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "{{ticketId}}"]
        }
      }
    },
    {
      "name": "14 - Verificar Acción DELETED en Historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Acción DELETED registrada en auditoría\", function () {",
              "    pm.response.to.have.status(200);",
              "    var page = pm.response.json();",
              "    var hasDeleted = page.content.some(function(item) { return item.action === \"DELETED\"; });",
              "    pm.expect(hasDeleted).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tickets/history?action=DELETED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tickets", "history"],
          "query": [
            { "key": "action", "value": "DELETED" }
          ]
        }
      }
    }
  ]
}
